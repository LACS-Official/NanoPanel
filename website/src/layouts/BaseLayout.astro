---
import { SITE_CONFIG } from "@/config/site";
import { getRelease } from "@/lib/release";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title = SITE_CONFIG.name,
  description = SITE_CONFIG.description,
  keywords = SITE_CONFIG.keywords,
  noindex = false,
} = Astro.props;

const release = await getRelease();
const umami = SITE_CONFIG.analytics.umami;
// 本地开发与预览不上报，避免污染统计
const umamiEnabled = umami.enabled && import.meta.env.PROD;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_CONFIG.name ? `${title} · 轻量服务器运维面板` : `${title} | ${SITE_CONFIG.name}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_CONFIG.name,
  description: SITE_CONFIG.description,
  url: SITE_CONFIG.url,
  applicationCategory: "SystemApplication",
  operatingSystem: SITE_CONFIG.product.platforms.join(", "),
  softwareVersion: release.version,
  datePublished: release.publishedAt || SITE_CONFIG.product.releaseDate,
  downloadUrl: release.assets[0]?.url ?? SITE_CONFIG.social.releases,
  codeRepository: SITE_CONFIG.social.github,
  author: {
    "@type": "Organization",
    name: SITE_CONFIG.author,
    url: SITE_CONFIG.social.studio,
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" },
};
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={SITE_CONFIG.author} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList[dark ? "add" : "remove"]("dark");
        } catch (e) {}
      })();
    </script>

    {
      umamiEnabled && (
        <script is:inline defer src={umami.scriptUrl} data-website-id={umami.websiteId} />
      )
    }
  </head>

  <body class="bg-white dark:bg-[#0b0b0d] text-gray-900 dark:text-gray-100 transition-colors duration-300 antialiased">
    <slot />

    <style is:global>
      body {
        font-family: Inter, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        overflow-x: hidden;
      }
      code, pre, .mono {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      ::selection {
        background: rgba(0, 113, 227, 0.18);
      }
      .np-gradient-text {
        background: linear-gradient(100deg, #0a84ff 0%, #0055d4 45%, #34c759 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .np-card {
        border: 1px solid rgb(0 0 0 / 0.07);
        background: #fff;
        border-radius: 20px;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      }
      .np-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px -18px rgb(16 42 80 / 0.22);
        border-color: rgb(0 113 227 / 0.3);
      }
      .dark .np-card {
        background: #141418;
        border-color: rgb(255 255 255 / 0.08);
      }
      .dark .np-card:hover {
        box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
        border-color: rgb(10 132 255 / 0.45);
      }
      .np-pre {
        border-radius: 16px;
        background: #0f1014;
        color: #e8e8ea;
        border: 1px solid rgb(255 255 255 / 0.08);
        overflow-x: auto;
      }
      .np-grid-bg {
        background-image: linear-gradient(rgb(0 0 0 / 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgb(0 0 0 / 0.045) 1px, transparent 1px);
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(760px 520px at 50% 30%, #000 12%, transparent 76%);
        mask-image: radial-gradient(760px 520px at 50% 30%, #000 12%, transparent 76%);
      }
      .dark .np-grid-bg {
        background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
      }
      .np-fade-up {
        animation: npFadeUp 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
      }
      @keyframes npFadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .np-fade-up { animation: none; }
      }
    </style>
    <!-- 版本实时同步：页面加载时向 GitHub 查询最新 Release，修正构建时固化的版本号、
         Release 链接与资产下载链接；查询失败则静默保留构建时数值。 -->
    <script is:inline>
      (function () {
        var REPO = "LACS-Official/NanoPanel";
        var TTL = 30 * 60 * 1000;
        var hasTargets = document.querySelector("[data-np-ver],[data-np-release-url],[data-np-asset]");
        if (!hasTargets) return;
        function apply(tag) {
          var m = /^v?(\d+\.\d+.*)$/.exec(tag || "");
          if (!m) return;
          var ver = m[1];
          document.querySelectorAll("[data-np-ver]").forEach(function (el) { el.textContent = ver; });
          var rel = "https://github.com/" + REPO + "/releases/tag/" + (tag.charAt(0) === "v" ? tag : "v" + tag);
          document.querySelectorAll("[data-np-release-url]").forEach(function (a) { a.href = rel; });
          document.querySelectorAll("[data-np-asset]").forEach(function (a) {
            if (a.href && a.href.indexOf("/releases/download/") !== -1) {
              a.href = a.href.replace(/\/releases\/download\/[^/]+\//, "/releases/download/" + (tag.charAt(0) === "v" ? tag : "v" + tag) + "/");
            }
          });
        }
        var cached = false;
        try {
          var ts = Number(localStorage.getItem("np-ver-ts") || 0);
          var tag = localStorage.getItem("np-ver-tag") || "";
          if (tag && Date.now() - ts < TTL) { apply(tag); cached = true; }
        } catch (e) {}
        if (cached) return;
        fetch("https://api.github.com/repos/" + REPO + "/releases/latest", { headers: { Accept: "application/vnd.github+json" } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.tag_name) return;
            apply(d.tag_name);
            try {
              localStorage.setItem("np-ver-tag", d.tag_name);
              localStorage.setItem("np-ver-ts", String(Date.now()));
            } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>

    <!-- 更新日志实时刷新：构建期已渲染最新版本小节；运行时若站点尚未重建，
         则拉取仓库 CHANGELOG.md 的最新小节替换，确保发版后日志不滞后。
         与上方版本同步共用 30 分钟缓存，失败则静默保留构建期内容。 -->
    <script is:inline>
      (function () {
        var box = document.querySelector("[data-np-changelog]");
        if (!box) return;
        var REPO = "LACS-Official/NanoPanel";
        var TTL = 30 * 60 * 1000;

        function esc(s) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
        function inlineMd(s) {
          var t = esc(s);
          t = t.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (_, a, u) {
            return '<a href="' + u + '" target="_blank" rel="noopener noreferrer">' + a + "</a>";
          });
          t = t.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
          t = t.replace(/`([^`]+)`/g, "<code>$1</code>");
          return t;
        }
        function renderMd(md) {
          var lines = md.split(/\r?\n/);
          var out = [];
          var inList = false;
          function close() { if (inList) { out.push("</ul>"); inList = false; } }
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].replace(/\s+$/, "");
            if (line.trim() === "") { close(); continue; }
            if (/^###\s+/.test(line)) { close(); out.push("<h3>" + inlineMd(line.replace(/^###\s+/, "")) + "</h3>"); continue; }
            if (/^##\s+/.test(line)) { close(); out.push("<h2>" + inlineMd(line.replace(/^##\s+/, "")) + "</h2>"); continue; }
            if (/^[-*]\s+/.test(line)) { if (!inList) { out.push("<ul>"); inList = true; } out.push("<li>" + inlineMd(line.replace(/^[-*]\s+/, "")) + "</li>"); continue; }
            close(); out.push("<p>" + inlineMd(line) + "</p>");
          }
          close();
          return out.join("\n");
        }
        function parseLatest(md) {
          var lines = md.split(/\r?\n/);
          var start = -1;
          for (var i = 0; i < lines.length; i++) {
            if (/^##\s+\[?[\d.]+\]?/.test(lines[i])) { start = i; break; }
          }
          if (start < 0) return null;
          var end = lines.length;
          for (var j = start + 1; j < lines.length; j++) {
            if (/^##\s+/.test(lines[j])) { end = j; break; }
          }
          var sec = lines.slice(start + 1, end).join("\n").trim();
          var m = /^##\s+\[?([\d.]+)\]?/.exec(lines[start]);
          return { version: m ? m[1] : "", html: renderMd(sec) };
        }
        function applyChangelog(version, html) {
          box.innerHTML = html;
          var lbl = document.querySelector("[data-np-changelog-ver]");
          if (lbl) lbl.textContent = version;
        }
        function fetchCl() {
          var base = "https://raw.githubusercontent.com/" + REPO + "/main/CHANGELOG.md";
          var urls = [base, "https://ghfast.top/" + base];
          (function tryNext(i) {
            if (i >= urls.length) return;
            fetch(urls[i])
              .then(function (r) { return r.ok ? r.text() : null; })
              .then(function (t) {
                if (!t) { tryNext(i + 1); return; }
                var sec = parseLatest(t);
                if (!sec) { tryNext(i + 1); return; }
                try {
                  localStorage.setItem("np-cl-ts", String(Date.now()));
                  localStorage.setItem("np-cl-v", sec.version);
                  localStorage.setItem("np-cl-html", sec.html);
                } catch (e) {}
                applyChangelog(sec.version, sec.html);
              })
              .catch(function () { tryNext(i + 1); });
          })(0);
        }
        try {
          var ts = Number(localStorage.getItem("np-cl-ts") || 0);
          var v = localStorage.getItem("np-cl-v") || "";
          var html = localStorage.getItem("np-cl-html") || "";
          if (html && v && Date.now() - ts < TTL) { applyChangelog(v, html); return; }
        } catch (e) {}
        fetchCl();
      })();
    </script>
  </body>
</html>
