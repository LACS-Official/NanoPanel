---
// 面板界面示意（纯 SVG，不依赖截图）
---

<div class="relative">
  <div
    class="absolute inset-0 -z-10 rounded-[32px] bg-gradient-to-tr from-[#0a84ff]/12 via-transparent to-[#34c759]/12 blur-2xl"
  >
  </div>
  <svg
    viewBox="0 0 960 600"
    class="w-full h-auto rounded-2xl border border-black/8 dark:border-white/10 shadow-[0_30px_80px_-30px_rgba(16,42,80,0.35)] dark:shadow-[0_30px_80px_-30px_rgba(0,0,0,0.8)]"
    role="img"
    aria-label="NanoPanel 面板界面示意"
  >
    <defs>
      <linearGradient id="pvBg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#f5f7fa"></stop>
      </linearGradient>
      <linearGradient id="pvLogo" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0a84ff"></stop>
        <stop offset="1" stop-color="#0055d4"></stop>
      </linearGradient>
      <linearGradient id="pvArea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0071e3" stop-opacity="0.28"></stop>
        <stop offset="1" stop-color="#0071e3" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    <rect width="960" height="600" rx="18" fill="url(#pvBg)"></rect>

    <rect x="0" y="0" width="196" height="600" fill="#ffffff"></rect>
    <line x1="196" y1="0" x2="196" y2="600" stroke="#ececf0"></line>

    <circle cx="34" cy="40" r="15" fill="url(#pvLogo)"></circle>
    <path d="M28 46V34l11 12V34" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <text x="58" y="45" font-family="Inter, sans-serif" font-size="15" font-weight="600" fill="#1d1d1f">NanoPanel</text>

    <g font-family="Inter, sans-serif" font-size="12.5" fill="#6b6b70">
      <rect x="14" y="74" width="168" height="32" rx="9" fill="#0071e3" fill-opacity="0.1"></rect>
      <circle cx="32" cy="90" r="4" fill="#0071e3"></circle>
      <text x="46" y="94" fill="#0071e3" font-weight="600">概览</text>
      <circle cx="32" cy="126" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="130">进程</text>
      <circle cx="32" cy="162" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="166">日志</text>
      <circle cx="32" cy="198" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="202">网络</text>
      <circle cx="32" cy="234" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="238">磁盘</text>
      <circle cx="32" cy="270" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="274">文件</text>
      <circle cx="32" cy="306" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="310">应用</text>
      <circle cx="32" cy="342" r="4" fill="#c9c9cf"></circle>
      <text x="46" y="346">设置</text>
    </g>

    <text x="228" y="46" font-family="Inter, sans-serif" font-size="20" font-weight="600" fill="#1d1d1f">概览</text>
    <text x="228" y="66" font-family="Inter, sans-serif" font-size="11.5" fill="#8a8a8f">系统状态、资源占用与运行概览</text>
    <rect x="838" y="32" width="92" height="30" rx="15" fill="#0071e3" fill-opacity="0.1"></rect>
    <text x="858" y="52" font-family="Inter, sans-serif" font-size="11.5" fill="#0071e3">● 运行中</text>

    <g>
      <rect x="228" y="84" width="222" height="92" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
      <text x="246" y="108" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">CPU 使用率</text>
      <text x="246" y="142" font-family="Inter, sans-serif" font-size="26" font-weight="600" fill="#1d1d1f">8.4%</text>
      <text x="246" y="162" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">4 核 · 负载 0.12</text>
    </g>
    <g>
      <rect x="466" y="84" width="222" height="92" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
      <text x="484" y="108" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">内存占用</text>
      <text x="484" y="142" font-family="Inter, sans-serif" font-size="26" font-weight="600" fill="#1d1d1f">186 MB</text>
      <text x="484" y="162" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">共 1 GB · 18%</text>
    </g>
    <g>
      <rect x="704" y="84" width="226" height="92" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
      <text x="722" y="108" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">CPU 温度</text>
      <text x="722" y="142" font-family="Inter, sans-serif" font-size="26" font-weight="600" fill="#1d1d1f">42°C</text>
      <text x="722" y="162" font-family="Inter, sans-serif" font-size="11" fill="#8a8a8f">阈值 75°C</text>
    </g>

    <rect x="228" y="192" width="460" height="200" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
    <text x="246" y="216" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#1d1d1f">网卡流量</text>
    <text x="246" y="233" font-family="Inter, sans-serif" font-size="10.5" fill="#8a8a8f">eth0 · 近 60 秒</text>
    <path
      d="M246 350 L286 330 L326 338 L366 306 L406 318 L446 286 L486 296 L526 268 L566 282 L606 250 L646 262 L672 246 L672 372 L246 372 Z"
      fill="url(#pvArea)"></path>
    <path
      d="M246 350 L286 330 L326 338 L366 306 L406 318 L446 286 L486 296 L526 268 L566 282 L606 250 L646 262 L672 246"
      fill="none"
      stroke="#0071e3"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M246 360 L286 352 L326 358 L366 344 L406 350 L446 336 L486 342 L526 330 L566 336 L606 322 L646 328 L672 318"
      fill="none"
      stroke="#34c759"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-opacity="0.85"></path>

    <rect x="704" y="192" width="226" height="200" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
    <text x="722" y="216" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#1d1d1f">资源水位</text>
    <g font-family="Inter, sans-serif" font-size="10.5" fill="#6b6b70">
      <text x="722" y="246">内存</text>
      <rect x="722" y="252" width="188" height="8" rx="4" fill="#eceef2"></rect>
      <rect x="722" y="252" width="42" height="8" rx="4" fill="#0071e3"></rect>
      <text x="722" y="286">磁盘</text>
      <rect x="722" y="292" width="188" height="8" rx="4" fill="#eceef2"></rect>
      <rect x="722" y="292" width="118" height="8" rx="4" fill="#0071e3"></rect>
      <text x="722" y="326">CPU</text>
      <rect x="722" y="332" width="188" height="8" rx="4" fill="#eceef2"></rect>
      <rect x="722" y="332" width="18" height="8" rx="4" fill="#34c759"></rect>
      <text x="722" y="362">温度</text>
      <rect x="722" y="368" width="188" height="8" rx="4" fill="#eceef2"></rect>
      <rect x="722" y="368" width="64" height="8" rx="4" fill="#34c759"></rect>
    </g>

    <rect x="228" y="408" width="702" height="164" rx="14" fill="#ffffff" stroke="#ececf0"></rect>
    <text x="246" y="432" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#1d1d1f">应用</text>
    <g font-family="Inter, sans-serif" font-size="11">
      <rect x="246" y="446" width="210" height="106" rx="12" fill="#fafafc" stroke="#ececf0"></rect>
      <rect x="262" y="462" width="30" height="30" rx="8" fill="#0a84ff"></rect>
      <text x="270" y="482" fill="#fff" font-size="13" font-weight="600">m</text>
      <text x="302" y="476" fill="#1d1d1f" font-weight="600">mihomo</text>
      <text x="302" y="492" fill="#8a8a8f" font-size="10.5">已安装 · 运行中</text>
      <rect x="262" y="510" width="70" height="24" rx="12" fill="#e4f8ea"></rect>
      <text x="276" y="526" fill="#1a9e44" font-size="10.5">管理面板</text>
      <rect x="340" y="510" width="46" height="24" rx="12" fill="#eef0f3"></rect>
      <text x="352" y="526" fill="#4a4a4f" font-size="10.5">配置</text>

      <rect x="470" y="446" width="210" height="106" rx="12" fill="#fafafc" stroke="#ececf0"></rect>
      <rect x="486" y="462" width="30" height="30" rx="8" fill="#1a9e44"></rect>
      <text x="494" y="482" fill="#fff" font-size="13" font-weight="600">A</text>
      <text x="526" y="476" fill="#1d1d1f" font-weight="600">AdGuard Home</text>
      <text x="526" y="492" fill="#8a8a8f" font-size="10.5">已安装 · 运行中</text>
      <rect x="486" y="510" width="54" height="24" rx="12" fill="#e4f8ea"></rect>
      <text x="498" y="526" fill="#1a9e44" font-size="10.5">打开</text>
      <rect x="548" y="510" width="46" height="24" rx="12" fill="#eef0f3"></rect>
      <text x="560" y="526" fill="#4a4a4f" font-size="10.5">配置</text>

      <rect x="694" y="446" width="210" height="106" rx="12" fill="#fafafc" stroke="#ececf0"></rect>
      <rect x="710" y="462" width="30" height="30" rx="8" fill="#7f56d9"></rect>
      <text x="718" y="482" fill="#fff" font-size="13" font-weight="600">f</text>
      <text x="750" y="476" fill="#1d1d1f" font-weight="600">frp 内网穿透</text>
      <text x="750" y="492" fill="#8a8a8f" font-size="10.5">已安装 · 运行中</text>
      <rect x="710" y="510" width="54" height="24" rx="12" fill="#eef0f3"></rect>
      <text x="720" y="526" fill="#4a4a4f" font-size="10.5">配置</text>
    </g>
  </svg>
</div>
