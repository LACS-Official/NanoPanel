---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="页面不存在" noindex={true}>
  <div class="max-w-2xl mx-auto px-6 py-28 md:py-36 text-center">
    <div class="text-6xl font-bold np-gradient-text tracking-tight">404</div>
    <h1 class="mt-4 text-2xl font-bold">这个页面不在面板里</h1>
    <p class="mt-3 text-gray-600 dark:text-gray-400">链接可能已经改过，或者你手抖打错了一个字符。</p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a href="/" class="rounded-full bg-[#0071e3] hover:bg-[#0064c8] text-white text-sm font-medium px-6 py-2.5 transition-colors"
        >返回首页</a
      >
      <a
        href="/docs"
        class="rounded-full border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 text-sm font-medium px-6 py-2.5 transition-colors"
        >查看文档</a
      >
    </div>
  </div>
</MainLayout>
