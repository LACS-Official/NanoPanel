---
import MainLayout from "@/layouts/MainLayout.astro";
import PanelPreview from "@/components/PanelPreview.astro";
import { SITE_CONFIG } from "@/config/site";

const { home, product } = SITE_CONFIG;

const icons: Record<string, string> = {
  dashboard:
    "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
  list: "M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01",
  apps: "M4 8h16v12H4zM8 8V6a4 4 0 018 0v2",
  folder: "M3 7h6l2 2h10v10H3z",
  clock: "M12 3a9 9 0 100 18 9 9 0 000-18zM12 7v5l4 2",
  network: "M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z",
  shield: "M12 3l8 3v6c0 5-3.4 8.2-8 9-4.6-.8-8-4-8-9V6z",
  refresh: "M20 12a8 8 0 11-2.6-5.9M20 4v5h-5",
};
---

<MainLayout title={SITE_CONFIG.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-14 pb-16 md:pt-20 md:pb-24">
    <div class="absolute inset-0 -z-10 np-grid-bg"></div>
    <div class="absolute inset-x-0 -top-40 -z-10 h-[420px] bg-[radial-gradient(600px_280px_at_50%_0%,rgba(10,132,255,0.16),transparent_70%)]">
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center np-fade-up">
        <a
          href={SITE_CONFIG.social.releases}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/70 dark:bg-gray-800/70 border border-gray-200/80 dark:border-gray-700/80 backdrop-blur text-xs font-medium text-gray-700 dark:text-gray-200 hover:border-gray-400 dark:hover:border-gray-500 transition-colors"
        >
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-70"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>v{product.version} 已发布 · 开源 MIT</span>
          <span class="text-gray-400">→</span>
        </a>

        <h1
          class="mt-7 text-[40px] leading-[1.1] sm:text-6xl md:text-7xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          一个二进制<br />
          <span class="np-gradient-text">管好一台服务器</span>
        </h1>

        <p class="mt-6 max-w-2xl mx-auto text-base md:text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
          {SITE_CONFIG.description}。没有 Nginx、没有数据库、没有容器，下载即用，
          为树莓派、软路由、N1 盒子和低配 VPS 而生。
        </p>

        <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/download"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-[#0071e3] hover:bg-[#0064c8] text-white font-medium px-7 py-3 transition-colors shadow-[0_10px_30px_-12px_rgba(0,113,227,0.7)]"
          >
            立即下载
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4.5-4.5M12 16l4.5-4.5M5 20h14"></path>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 text-gray-800 dark:text-gray-200 font-medium px-7 py-3 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            查看源码
          </a>
        </div>

        <p class="mt-4 text-xs text-gray-500 dark:text-gray-500">{home.hero.note}</p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-[11.5px] font-mono">
          {
            product.platforms.map((p) => (
              <span class="px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-800/80 text-gray-600 dark:text-gray-400">
                {p}
              </span>
            ))
          }
        </div>
      </div>

      <div class="mt-14 md:mt-20 np-fade-up" style="animation-delay:120ms">
        <PanelPreview />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-gray-100 dark:border-gray-900 bg-gray-50/60 dark:bg-[#0f0f12]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-14">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {
          home.stats.map((s) => (
            <div class="text-center lg:text-left">
              <div class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">{s.value}</div>
              <div class="mt-1.5 text-sm font-medium text-gray-800 dark:text-gray-200">{s.label}</div>
              <div class="mt-1 text-xs text-gray-500 dark:text-gray-500 leading-relaxed">{s.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">该有的都有</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">
          面板里每一个功能，都按「小内存设备也能跑得动」的标准重新设计过。
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          home.features.map((f) => (
            <div class="np-card p-6">
              <div class="w-10 h-10 rounded-xl bg-[#0071e3]/10 text-[#0071e3] flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d={icons[f.icon]} />
                </svg>
              </div>
              <h3 class="mt-4 font-semibold text-[15px]">{f.title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-gray-600 dark:text-gray-400">{f.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8">
        <a href="/features" class="inline-flex items-center gap-1.5 text-sm font-medium text-[#0071e3] hover:gap-2.5 transition-all">
          查看全部功能
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick start -->
  <section class="py-20 md:py-24 bg-gray-50 dark:bg-[#0f0f12] border-y border-gray-100 dark:border-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{home.quickstart.title}</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400 leading-relaxed">{home.quickstart.desc}</p>
        <ul class="mt-7 space-y-3 text-sm text-gray-700 dark:text-gray-300">
          <li class="flex gap-2.5">
            <span class="text-[#34c759] font-bold">✓</span>自动识别 CPU 架构并下载对应二进制
          </li>
          <li class="flex gap-2.5">
            <span class="text-[#34c759] font-bold">✓</span>注册 systemd 服务，开机自启
          </li>
          <li class="flex gap-2.5">
            <span class="text-[#34c759] font-bold">✓</span>生成随机初始密码，浏览器打开 <span class="mono">:8080</span> 即可登录
          </li>
        </ul>
      </div>
      <div class="np-pre p-5 md:p-6 text-[13px] leading-relaxed">
        <div class="flex items-center gap-1.5 mb-4">
          <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
          <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
          <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-auto text-[11px] text-gray-500">bash</span>
        </div>
        <pre class="whitespace-pre-wrap break-all text-gray-200"
        ><code><span class="text-gray-500"># 一键安装</span>
<span class="text-[#7ee787]">curl</span> -fsSL https://npanel.lacs.cc/install.sh | <span class="text-[#7ee787]">sudo bash</span>
<span class="text-[#7ee787]">sudo systemctl</span> enable --now nanopanel</code></pre>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center">{home.why.title}</h2>
      <div class="mt-12 grid md:grid-cols-3 gap-5">
        {
          home.why.items.map((it, i) => (
            <div class="np-card p-7">
              <div class="text-xs font-mono text-[#0071e3]">0{i + 1}</div>
              <h3 class="mt-3 font-semibold text-lg">{it.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{it.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="relative overflow-hidden rounded-3xl border border-gray-200 dark:border-gray-800 bg-gradient-to-br from-[#f6f9ff] to-[#eef7f1] dark:from-[#12151c] dark:to-[#101812] p-10 md:p-14 text-center"
      >
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{home.cta.title}</h2>
        <p class="mt-4 text-gray-600 dark:text-gray-400">{home.cta.desc}</p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/download"
            class="w-full sm:w-auto rounded-full bg-[#0071e3] hover:bg-[#0064c8] text-white font-medium px-7 py-3 transition-colors"
            >{home.cta.downloadText}</a
          >
          <a
            href="/docs"
            class="w-full sm:w-auto rounded-full border border-gray-300 dark:border-gray-700 hover:border-gray-400 dark:hover:border-gray-500 font-medium px-7 py-3 transition-colors"
            >{home.cta.docsText}</a
          >
        </div>
        <p class="mt-5 text-xs text-gray-500 dark:text-gray-500">
          {product.size} · {product.memory} · MIT License
        </p>
      </div>
    </div>
  </section>
</MainLayout>
