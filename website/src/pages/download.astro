---
import MainLayout from "@/layouts/MainLayout.astro";
import { SITE_CONFIG } from "@/config/site";
import { getRelease } from "@/lib/release";

const { downloadPage, install, social } = SITE_CONFIG;
const release = await getRelease();

const cards = downloadPage.assets.map((a, i) => {
  const asset = release.assets.find((x) => x.name === a.file) ?? release.assets[i];
  return { ...a, asset };
});

const releaseLabel = release.publishedAt
  ? `${release.publishedAt} 发布`
  : release.source === "api"
    ? "GitHub 最新版"
    : "最新稳定版";
---

<MainLayout title="下载" description="下载 NanoPanel 单二进制，支持 amd64 / arm64 / armv7。">
  <section class="relative overflow-hidden pt-16 pb-10">
    <div class="absolute inset-0 -z-10 np-grid-bg"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{downloadPage.hero.title}</h1>
      <p class="mt-5 text-gray-600 dark:text-gray-400">{downloadPage.hero.subtitle}</p>
      <div
        class="mt-6 inline-flex flex-wrap items-center justify-center gap-2 rounded-full border border-gray-200 dark:border-gray-800 bg-white/70 dark:bg-gray-800/60 px-4 py-1.5 text-xs text-gray-600 dark:text-gray-300"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
        </span>
        最新版本
        <a
          href={release.releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-np-release-url
          class="font-mono font-medium text-[#0071e3] hover:underline">v<span data-np-ver>{release.version}</span></a
        >
        <span class="text-gray-300 dark:text-gray-600">·</span>
        {releaseLabel}
      </div>
      {release.source === "fallback" && (
        <p class="mt-3 text-[11px] text-amber-600 dark:text-amber-500">
          当前展示的是站点兜底版本号，实际下载地址始终指向 GitHub 最新 Release。
        </p>
      )}
    </div>
  </section>

  <section class="pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-5">
        {
          cards.map((a) => (
            <div class="np-card p-6 flex flex-col">
              <div class="flex items-start justify-between gap-3">
                <h2 class="font-semibold text-lg">{a.name}</h2>
                {a.asset?.size && (
                  <span class="shrink-0 mt-1 rounded-md bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-[10.5px] font-mono text-gray-500 dark:text-gray-400">
                    {a.asset.sizeText}
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[13px] text-gray-500 dark:text-gray-400 leading-relaxed">{a.requirement}</p>
              <div class="mt-4 rounded-lg bg-gray-50 dark:bg-[#17171b] border border-gray-100 dark:border-gray-800 px-3 py-2 text-[11.5px] font-mono text-gray-600 dark:text-gray-400 break-all">
                {a.file}
              </div>
              <div class="mt-auto pt-4">
                <a
                  href={a.asset?.url ?? `${social.releases}/latest/download/${a.file}`}
                  data-np-asset
                  class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-[#0071e3] hover:bg-[#0064c8] text-white text-sm font-medium px-5 py-2.5 transition-colors"
                >
                  下载
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4.5-4.5M12 16l4.5-4.5M5 20h14" />
                  </svg>
                </a>
                <a
                  href={a.asset?.sha256Url ?? `${social.releases}/latest/download/${a.file}.sha256`}
                  data-np-asset
                  class="mt-2.5 block text-center text-[11.5px] text-gray-500 hover:text-[#0071e3] transition-colors mono"
                >
                  sha256 校验文件
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-center text-xs text-gray-500 dark:text-gray-500">
        所有版本与历史记录见
        <a href={social.releases} target="_blank" rel="noopener noreferrer" class="text-[#0071e3] hover:underline"
          >GitHub Releases</a
        >。国内下载慢时可用镜像前缀 <span class="mono">https://ghfast.top/</span>。
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-baseline gap-3 mb-6">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">更新日志</h2>
        <span class="text-sm font-mono text-[#0071e3] dark:text-[#60a5fa]">v<span data-np-changelog-ver>{release.version}</span></span>
      </div>
      {
        release.changelogHtml ? (
          <div class="np-changelog prose dark:prose-invert max-w-none" data-np-changelog-latest set:html={release.changelogHtml} />
        ) : (
          <p class="text-sm text-gray-500 dark:text-gray-400">
            暂无可展示的更新日志，请前往
            <a href={release.releaseUrl} target="_blank" rel="noopener noreferrer" class="text-[#0071e3] dark:text-[#60a5fa] hover:underline">GitHub 发布说明 ↗</a>
            查看。
          </p>
        )
      }

      {
        release.changelogHistory && release.changelogHistory.length > 1 && (
          <div class="mt-8">
            <h3 class="text-lg font-semibold tracking-tight mb-3">历史版本</h3>
            <div class="np-history" data-np-changelog-history>
              {release.changelogHistory.slice(1).map((e) => (
                <details class="np-history-item">
                  <summary>
                    <span class="np-history-ver">v{e.version}</span>
                    {e.date && <span class="np-history-date">{e.date}</span>}
                    <svg class="np-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                  </summary>
                  <div class="np-changelog prose dark:prose-invert max-w-none np-changelog--nested" set:html={e.html} />
                </details>
              ))}
            </div>
          </div>
        )
      }

      <p class="mt-5 text-xs text-gray-500 dark:text-gray-500">
        完整历史版本与变更见
        <a href={social.releases} target="_blank" rel="noopener noreferrer" class="text-[#0071e3] dark:text-[#60a5fa] hover:underline">GitHub Releases</a>。
      </p>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-[#0f0f12] border-y border-gray-100 dark:border-gray-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{downloadPage.install.title}</h2>
      <p class="mt-3 text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{downloadPage.install.note}</p>

      <div class="np-pre mt-6">
        <div class="flex items-center gap-1.5 px-5 pt-4">
          <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
          <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
          <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-auto text-[11px] text-gray-500">bash</span>
          <button
            type="button"
            data-copy={install.command}
            class="ml-3 rounded-md border border-white/10 px-2 py-1 text-[11px] text-gray-400 hover:text-white hover:border-white/30 transition-colors"
            >复制</button
          >
        </div>
        <pre class="px-5 pb-5 pt-3 text-[13px] leading-relaxed whitespace-pre-wrap break-all text-gray-200"><code><span class="text-[#7ee787]">curl</span> -fsSL {install.scriptUrl} | <span class="text-[#7ee787]">sudo bash</span></code></pre>
      </div>

      <div class="mt-4 grid sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4 bg-white/60 dark:bg-transparent">
          <div class="font-medium text-[13.5px]">国内网络较慢</div>
          <div class="mt-2 rounded-lg bg-[#0f1014] px-3 py-2 text-[11.5px] font-mono text-gray-300 break-all">
            export GITHUB_MIRROR=https://ghfast.top/https://github.com
          </div>
          <p class="mt-2 text-[12px] text-gray-500 dark:text-gray-400 leading-relaxed">
            脚本也会自动测速，从 GitHub / ghfast / ghproxy 中挑最快的源。
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4 bg-white/60 dark:bg-transparent">
          <div class="font-medium text-[13.5px]">安装指定版本 / 目录</div>
          <div class="mt-2 rounded-lg bg-[#0f1014] px-3 py-2 text-[11.5px] font-mono text-gray-300 break-all">
            curl -fsSL {install.scriptUrl} | sudo NP_VERSION=v<span data-np-ver>{release.version}</span> bash
          </div>
          <p class="mt-2 text-[12px] text-gray-500 dark:text-gray-400 leading-relaxed">
            还可用 <span class="mono">NP_PORT</span>、<span class="mono">NP_USERNAME</span>、<span class="mono">NP_PASSWORD</span>、
            <span class="mono">NP_INSTALL_DIR</span> 覆盖默认值。
          </p>
        </div>
      </div>

      <p class="mt-4 text-xs text-gray-500">
        脚本内容与仓库 <span class="mono">deploy/install.sh</span> 完全一致，构建时自动同步；
        也可以直接从
        <a href={install.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[#0071e3] hover:underline"
          >GitHub 源码</a
        > 查看或下载。
      </p>
    </div>
  </section>

  <section class="pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight">{downloadPage.manual.title}</h2>
      <div class="np-pre mt-6 p-5 text-[13px] leading-relaxed">
        <pre class="whitespace-pre-wrap break-all text-gray-200"><code><span class="text-[#7ee787]">cd</span> /tmp
<span class="text-[#7ee787]">wget</span> {social.releases}/latest/download/nanopanel-amd64
<span class="text-[#7ee787]">wget</span> {social.releases}/latest/download/nanopanel-amd64.sha256
<span class="text-[#7ee787]">sha256sum</span> -c nanopanel-amd64.sha256
<span class="text-[#7ee787]">chmod</span> +x nanopanel-amd64
<span class="text-[#7ee787]">sudo</span> install -m 0755 nanopanel-amd64 /opt/nanopanel/nanopanel
<span class="text-gray-500"># 首次运行前先生成配置（会打印初始密码）</span>
<span class="text-[#7ee787]">sudo</span> /opt/nanopanel/nanopanel -init -c /etc/nanopanel/config.json -port 8080
<span class="text-[#7ee787]">sudo</span> /opt/nanopanel/nanopanel -c /etc/nanopanel/config.json</code></pre>
      </div>
      <div class="mt-6 grid sm:grid-cols-2 gap-4 text-sm">
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4">
          <div class="font-medium">忘记密码？</div>
          <p class="mt-1.5 text-gray-600 dark:text-gray-400 text-[13px] leading-relaxed">
            删除 <span class="mono">config.json</span> 中的 <span class="mono">password_hash</span> 字段并重启，面板会重新生成初始密码；
            或执行 <span class="mono">sudo npctl reset-password</span>。
          </p>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4">
          <div class="font-medium">升级版本？</div>
          <p class="mt-1.5 text-gray-600 dark:text-gray-400 text-[13px] leading-relaxed">
            面板「关于」页有「立即升级」按钮，也可执行 <span class="mono">sudo npctl upgrade</span>。
          </p>
        </div>
      </div>
    </div>
  </section>
  </MainLayout>

<!-- 这些样式必须全局生效：运行时脚本会用 innerHTML 重绘历史折叠列表与嵌套更新日志，
     重绘出的元素不带 Astro 的 data-astro-cid 作用域属性，scoped 规则会全部失效
     （表现为版本号与日期挤在一起、列表无边框）。类名均为 np- 前缀，仅本页使用，全局化安全。 -->
<style is:global>
  .np-changelog {
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.07);
    border-radius: 20px;
    padding: 1.5rem 1.75rem;
  }
  .dark .np-changelog {
    background: #141418;
    border-color: rgb(255 255 255 / 0.08);
  }
  .np-changelog :global(h3) {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .np-changelog :global(h3:first-child) {
    margin-top: 0;
  }
  .np-changelog :global(ul) {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
  }
  .np-changelog :global(li) {
    margin: 0.25rem 0;
  }
  .np-changelog :global(code) {
    background: rgb(0 0 0 / 0.05);
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    font-size: 0.85em;
  }
  .dark .np-changelog :global(code) {
    background: rgb(255 255 255 / 0.08);
  }
  .np-changelog :global(a) {
    color: #0071e3;
    text-decoration: none;
  }
  .np-changelog :global(a:hover) {
    text-decoration: underline;
  }
  .dark .np-changelog :global(a) {
    color: #60a5fa;
  }

  /* —— 历史版本折叠列表 —— */
  .np-history {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .np-history-item {
    border: 1px solid rgb(0 0 0 / 0.07);
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
  }
  .dark .np-history-item {
    border-color: rgb(255 255 255 / 0.08);
    background: #141418;
  }
  .np-history-item > summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.95rem;
    font-weight: 600;
    user-select: none;
  }
  .np-history-item > summary::-webkit-details-marker {
    display: none;
  }
  .np-history-item > summary:focus-visible {
    outline: 2px solid #0071e3;
    outline-offset: -2px;
  }
  .np-history-ver {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #0071e3;
  }
  .dark .np-history-ver {
    color: #60a5fa;
  }
  .np-history-date {
    font-size: 0.8rem;
    font-weight: 400;
    color: #9ca3af;
  }
  .dark .np-history-date {
    color: #6b7280;
  }
  .np-chevron {
    margin-left: auto;
    color: #9ca3af;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .np-history-item[open] > summary .np-chevron {
    transform: rotate(180deg);
  }
  .np-changelog--nested {
    border: none;
    border-radius: 0;
    border-top: 1px solid rgb(0 0 0 / 0.07);
    padding: 1.2rem 1.5rem 1.5rem;
  }
  .dark .np-changelog--nested {
    border-top-color: rgb(255 255 255 / 0.08);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = "已复制";
        setTimeout(() => (btn.textContent = prev), 1500);
      } catch {
        btn.textContent = "复制失败";
        setTimeout(() => (btn.textContent = "复制"), 1500);
      }
    });
  });
</script>
