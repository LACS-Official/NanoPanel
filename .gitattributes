# 保证 shell 脚本与 Makefile 在任何平台检出后都是 LF。
* text=auto

*.sh        text eol=lf
mpctl       text eol=lf
Makefile    text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.go        text eol=lf
*.mod       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.gitignore text eol=lf

# 二进制构建产物不做任何转换
*.png binary
*.jpg binary
